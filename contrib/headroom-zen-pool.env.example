# Zen egress pool. `claude-launcher` and `restart-headroom.sh` source
# ~/.headroom-zen-pool.env (or $HEADROOM_ZEN_POOL_ENV) before they start the
# proxy, so the pool never depends on what the calling shell exported.
#
# Both skip the file unless you own it and group/other have no access
# (mode 0600). Generate it from the running relay rather than copying this
# example, so the ports match the lanes that verified:
#
#   (umask 077; ~/.local/bin/nord-socks-egress env > ~/.headroom-zen-pool.env)
#   restart-headroom.sh
#
# Hand-write it only for a relay other than nord-socks-egress. Lanes that
# point at nothing fail every Zen request assigned to them.
#
# Without this file, Zen shares the device-wide route, and the legacy watcher
# rotates the whole VPN on each Zen 429 — which resets every Codex and Spark
# stream in flight. `restart-headroom.sh` warns when it starts that way while
# the relay is healthy.

# One proxy URL per line, one Zen egress lane each. Only Zen-routed requests
# use it; Claude and Codex keep their own transport. A URL may carry
# credentials, which is why this is a file and never a CLI flag.
export HEADROOM_ZEN_HTTP_PROXY_POOL='socks5h://127.0.0.1:18600
socks5h://127.0.0.1:18601
socks5h://127.0.0.1:18602
socks5h://127.0.0.1:18603
socks5h://127.0.0.1:18604
socks5h://127.0.0.1:18605
socks5h://127.0.0.1:18606
socks5h://127.0.0.1:18607'

# Called by the per-egress watcher as `<egress-id> <rate-limit|proactive|manual>`
# to rotate one lane. Must be executable, or rotation stays off.
export HEADROOM_ZEN_EGRESS_ROTATE_COMMAND="$HOME/.local/bin/nord-socks-egress"
